{
  "name": "print-menu-local-renderer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node -e \"process.env.RENDER_SCALE=process.env.RENDER_SCALE||'1'; import('./server.js')\"",
    "setup": "playwright install chromium",
    "setup:local-browsers": "node scripts/setup-playwright-local.mjs",
    "dev:desktop": "electron .",
    "dev:mac": "electron .",
    "dev:win": "electron .",
    "dist:mac": "npm run setup:local-browsers && npm run dist:mac:arm64 && npm run dist:mac:x64",
    "dist:mac:arm64": "electron-builder --mac dmg --arm64 --config electron-builder.json",
    "dist:mac:x64": "electron-builder --mac dmg --x64 --config electron-builder.json",
    "dist:win": "npm run setup:local-browsers && electron-builder --win nsis --config electron-builder.json",
    "package": "node scripts/package-renderer.mjs"
  },
  "dependencies": {
    "express": "latest",
    "ffmpeg-static": "^5.2.0",
    "playwright": "1.49.1"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
